{
  "name": "docassist",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:single": "tsc && vite build --mode single",
    "build:html": "npm run build:single && node -e \"require('fs').copyFileSync('dist-single/index.html','DocAssist.html')\"",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.30.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.7.0",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^0.21.2",
    "vite-plugin-singlefile": "~2.3.0",
    "vitest": "^3.2.7"
  }
}
