#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# DocAssist — помощник для работы с репозиторием на компьютере (macOS, Linux).
# Меню: ./tools/da   ·   Сразу действие: ./tools/da status | pull | commit "текст" | push | sync | branch | merge | pr | release | build | doctor
# Совместимо с bash 3.2 (стоит на macOS по умолчанию).

# Папка скрипта (с учётом ссылки ~/bin/da → tools/da).
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
DA_DIR=$(cd -P "$(dirname "$src")" && pwd)

. "$DA_DIR/lib/ui.sh"
. "$DA_DIR/lib/git.sh"
. "$DA_DIR/lib/build.sh"
. "$DA_DIR/lib/release.sh"

ROOT=$(git -C "$DA_DIR" rev-parse --show-toplevel 2>/dev/null) || { fail "Скрипт должен лежать внутри репозитория DocAssist"; exit 1; }
cd "$ROOT" || exit 1
detect_repo

usage() {
  cat <<HELP
${B}DocAssist — помощник${N}

  ${B}da${N}                 меню
  ${B}da status${N}          состояние: ветка, изменения, последние коммиты
  ${B}da pull${N}            обновить ветку с GitHub
  ${B}da commit${N} "текст"  сохранить все изменения с описанием
  ${B}da push${N}            отправить на GitHub
  ${B}da sync${N}            обновить и отправить
  ${B}da branch${N}          ветки: переключить, создать, удалить
  ${B}da merge${N}           влить другую ветку в текущую
  ${B}da pr${N}              Pull Request
  ${B}da release${N}         релизы: выпустить, версия, описание
  ${B}da build${N}           собрать DocAssist.html, проверки, запуск
  ${B}da doctor${N}          проверить, всё ли установлено
HELP
}

menu() {
  while :; do
    printf '\n%sDocAssist — помощник%s   %s\n' "$B" "$N" "$(branch_line)"
    CHOICE_ZERO="Выход"
    choose "Что сделать?" \
      "Состояние (что изменено, последние коммиты)" \
      "Обновить ветку с GitHub (pull)" \
      "Сохранить изменения (commit)" \
      "Отправить на GitHub (push)" \
      "Обновить и отправить (sync)" \
      "Ветки: переключить, создать, удалить" \
      "Влить другую ветку в текущую (merge)" \
      "Pull Request (например, testing → main)" \
      "Релизы: выпустить, версия, описание" \
      "Собрать DocAssist.html, проверки, запуск" \
      "История коммитов" \
      "Проверить окружение (git, gh, node)"
    CHOICE_ZERO=""
    case $CHOICE in
      0) say "Пока!"; return 0 ;;
      1) cmd_status ;;
      2) cmd_pull ;;
      3) cmd_commit ;;
      4) cmd_push ;;
      5) cmd_sync ;;
      6) cmd_branch ;;
      7) cmd_merge ;;
      8) cmd_pr ;;
      9) cmd_release ;;
      10) cmd_build ;;
      11) cmd_log ;;
      12) cmd_doctor ;;
    esac
  done
}

case "${1:-}" in
  '') menu ;;
  status) cmd_status ;;
  pull) cmd_pull ;;
  commit) shift; cmd_commit "$*" ;;
  push) cmd_push ;;
  sync) cmd_sync ;;
  branch) cmd_branch ;;
  merge) cmd_merge ;;
  pr) cmd_pr ;;
  release) cmd_release ;;
  version) cmd_version ;;
  notes) cmd_notes ;;
  build) cmd_build ;;
  log) cmd_log ;;
  doctor) cmd_doctor ;;
  help|-h|--help) usage ;;
  *) fail "Неизвестная команда: $1"; usage; exit 1 ;;
esac
